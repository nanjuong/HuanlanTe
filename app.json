{
  "expo": {
    "name": "HuanlanTe",
    "slug": "huanlante-ewtgg2gr8dqrp06xvqxm",
    "description": "A bilingual manual camera app for iOS and Android, built with Expo and VisionCamera.",
    "githubUrl": "https://github.com/nanjuong/HuanlanTe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080A08",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.huanlante.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "HuanlanTe uses the camera to capture photos.",
        "NSPhotoLibraryUsageDescription": "HuanlanTe reads your selected photos.",
        "NSPhotoLibraryAddUsageDescription": "HuanlanTe saves the photos you capture.",
        "CFBundleLocalizations": [
          "en",
          "zh-CN",
          "zh-TW"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.huanlante.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "HuanlanTe reads your selected photos.",
          "savePhotosPermission": "HuanlanTe saves the photos you capture.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-CN",
              "zh-TW"
            ],
            "android": [
              "en",
              "zh-CN",
              "zh-TW"
            ]
          }
        }
      ]
    ],
    "locales": {
      "en": "./src/locales/en.json",
      "zh-CN": "./src/locales/zh-CN.json",
      "zh-TW": "./src/locales/zh-TW.json"
    },
    "extra": {
      "eas": {
        "projectId": "6676afc0-4c18-4048-8cf7-5d5521204e26"
      }
    },
    "owner": "aerospace-future-technology-studio"
  }
}
